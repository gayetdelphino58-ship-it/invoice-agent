# Copier ce fichier en .env et remplir les valeurs

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Modèle Bedrock (Claude 3.5 Sonnet par défaut)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# DynamoDB — nom de la table
DYNAMODB_TABLE_NAME=invoices

# SNS — ARN du topic pour les rappels (laisser vide pour le mode dev console)
SNS_TOPIC_ARN=

# Nombre de jours avant l'échéance pour déclencher un rappel
REMINDER_DAYS_BEFORE=3
